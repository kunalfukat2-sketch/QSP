// Sum of prime in between Range 1- 100;
class  SumPrimeMethod
{
	public static void main(String[] args) 
	{
		
		int sum = 0;
		
		for (int i = 1; i <= 1000  ; i++ )
		{
			if (isPrime(i))
			{
				sum = sum + i;
				
			}
		}
		
		System.out.println(sum);
	}
	
	public static boolean isPrime(int num)
	{
		if (num<=1)
		{
			return false;
		}
		else
		{
			for ( int i = 2; i < num ; i++ )
			{
				if ( num % i == 0)
				{
					return false;
				}
			}
			
			return true;
		}
	}
}
