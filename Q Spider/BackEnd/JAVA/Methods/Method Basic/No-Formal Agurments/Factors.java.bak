import java.util.Scanner;
class Factors 
{
	static int num;
	
	public static void main(String[] args) 
	{
		System.out.println("Enter a Number:");
		num = new Scanner(System.in).nextInt();
		
		findFactors();
	}
	
	public static void findFactors()
	{
		
		for (int i = 1 ; i <= num ;i++ )
		{
			if (num%i==0)
			{
				System.out.println(i);
			}
		}
	}
	
}
