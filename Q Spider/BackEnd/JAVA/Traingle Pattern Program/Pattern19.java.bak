//                               1
//                             1 2 1
//                           1 2 3 2 1
//                         1 2 3 4 3 2 1
//                       1 2 3 4 5 4 3 2 1

class Pattern19
{
	public static void main(String[] args) 
	{
int n = 5;

for (int i= 1; i <=n ;i++ )
{
	for (int j=1; j<=n-i ;j++ )
	{
		System.out.print("  ");
	}
	
	
	int num = 1;
	for (int j = 1; j<=i*2-1 ; j++)
	{
		System.out.print(num + " ");
		
		
		
		if (j<i)
		{
			num++;
		}
		else
		{
			num--;
		}
		
		
	}
	
	System.out.println();
}
	}
}
