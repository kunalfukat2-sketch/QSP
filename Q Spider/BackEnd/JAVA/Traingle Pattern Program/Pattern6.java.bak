  //    A
  //    A B
  //    A B C
  //    A B C D

class Pattern6 
{
	public static void main(String[] args) 
	{
		int n = 4;
		
		for (int i = 1 ; i<=n ;i++ )
		{
			char ch = (char) ('A'+(n*n)/2-1);
			
			for (int j=1 ;j<=n ;j++ )
			{
				if (i>=j)
				{
					System.out.print(ch++ +" ");
				}
			}
			
			System.out.println();
		}
	}
}
