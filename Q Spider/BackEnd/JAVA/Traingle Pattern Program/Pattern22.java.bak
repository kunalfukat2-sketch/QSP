import java.util.Scanner;
class Pattern2
{
	public static void main(String[] args) 
	{
		Scanner sc = new Scanner(System.in);
		System.out.print("Enter a num Of Rows : ");
		int n = sc.nextInt();
		
		int num = 1;
		
		for (int i = 1; i<=n ;i++ )
		{	
			
			
			for (int j = 1; j<=n ; j++ )
			{
				if (i>=j)
				{
					System.out.print(num +" ");
				}
				
				
			}
			
			num  = num+1;
			
			
			

			System.out.println();
		}
		  
		
	}
}  
