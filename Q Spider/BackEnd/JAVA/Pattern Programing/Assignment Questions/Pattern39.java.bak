// 1 2 3 4 5
// 1       5
// 1       5
// 1       5
// 1 2 3 4 5        

class Pattern39 
{
	public static void main(String[] args) 
	{
		int n = 7;
		
		int num = 1;
		 
		int  a=num;
		int  b=num;
		int  c=num;
		int  d=num;
		 
		for (int i=1 ; i<=n ; i++ )
		{
			for (int j=1 ; j<=n ;j++ )
			{
				if (j==n || i==1 || i==n || j==1)
				{
					System.out.print(j +" ");
				}
				else
				{
					System.out.print(" " +" ");
				}
			}
			
			System.out.println();
		}
	}
}
