 // 1 2 3 4 5 6 7
 // 1 2         7
 // 1   3       7
 // 1     4     7
 // 1       5   7
 // 1         6 7
 // 1 2 3 4 5 6 7
class Pattern40 
{
	public static void main(String[] args) 
	{
		int n = 6;
		
		int num = 1;
		 
		for (int i=1 ; i<=n ; i++ )
		{
			for (int j=1 ; j<=n ;j++ )
			{
				if (j==n || i==1 || i==n || j==1 || i==j)
				{
					System.out.print(j +" ");
				}
				else
				{
					System.out.print(" " +" ");
				}
			}
			
			System.out.println();
		}
	}
}
