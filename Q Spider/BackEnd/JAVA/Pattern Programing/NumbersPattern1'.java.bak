class NumbersPattern1

{
	public static void main(String[] args) 
	{
		int n = 5;
		int num=1;
		for (int i=1; i<=n ;i++ )
		{
			for (int j=1;j<=n ;j++ )
			{
				if (i==1)
				{   int a=num;
					System.out.print(a++ + " ");
				}
				else if (j==1)
				{
					int b=num;
					System.outprin(b++ + " " );
					
				}
				else if (i==n)
				{
					int c=n;
					System.out.print(c--  + " ");
				}
				else if (j==n)
				{
					int d=n;
					System.out.print(d-- + " ");
				}
				
				
			
			System.out.println();
		}
	}
}
