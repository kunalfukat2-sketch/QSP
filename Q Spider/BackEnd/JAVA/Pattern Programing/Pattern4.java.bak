import java.util.Scanner;
class Pattern4 
{
	public static void main(String[] args) 
	{
		Scanner sc = new Scanner(System.in);
		
		System.out.print("Enter a Rows:");
		int n = sc.nextInt();
		
		System.out.print("Enter a Table Number:");
		int num = sc.nextInt();
		
		//int a = num;
		
		for (int i = 1; i<=n ;i++ )
		{
			for (int j= 1; j<=n ;j++ )
			{
				System.out.print(num +" ");
				if (num<10)
				{
					System.out.print(" ");
				}
				//a = a+num;
				num=num*j;
			}
			
			System.out.println();
		}
	}
}
