class Pattern6 
{
	public static void main(String[] args) 
	{
		int n = 4;
		
		int a = (n*n)/2;
		
		char b = 'a';
		
		for (int i = 1 ; i<=n ; i++ )
		{
			for (int j = 1 ; j<=n ;j++ )
			{
				if (j%2!=0)
				{
					System.out.print(b++ +" ");
					if(a<=9) System.out.print(" ");
				}
				else
				{
					System.out.print(a++ + " ");
				}
			}
			
			System.out.println();
		}
	}
}
