 //Print the number from 1 to 5 using all loops - for , while, do while.


//for
class Pratice1 
{
	public static void main(String[] args) 
	{
		
		for (int i = 1; i <= 5; i++ )
			
		{
			 System.out.println(i);
		}
			
		
	}






//While
class Pratice1 
{
	public static void main(String[] args) 
	{
		
		int i = 1;
		
		while (i <= 5)
			
		{
			System.out.println(i);
			i++;
		}
		
	}
}






 //do while
  class Pratice1 
  {
	public static void main(String[] args) 
	{
		
		int i = 1;
		
		do
		{
			System.out.println(i);
			i++;
		}
		while ( i<=5 );
		
	}
  }}